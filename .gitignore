# --- KARTUN: ignore-first ---

# The owner's voice portrait - the PUBLIC snapshot of his voice core (owner's choice 2026-10-14,
# chat answer "Публичный слепок"). This repository is public and a portrait may quote the owner's
# private writing, so the file lives on disk and never ships.
# Refresh it with: cp d:\work\ai_sandbox\KAIF\AUTHOR_STYLOMETRY.md .
AUTHOR_STYLOMETRY.md

# Signing keys and secrets for stage and prod builds - they live on the owner's machine in the
# project root, never in git (owner's word 2026-10-14, chat). Only a value-free .env.example may ship.
.env
.env.*
!.env.example
*.jks
*.keystore
keystore.properties

# Android / Gradle build output and local machine files.
.gradle/
build/
local.properties
.idea/
*.iml
.externalNativeBuild/
.cxx/
captures/

# Third-party native packages downloaded by tools/fetch-ncnn.mjs (pinned by SHA-256 in the script).
engine/third_party/

# Python environment for model conversion (tools/convert-model.py) - local only.
.venv-convert/

# Mockup images cut from the owner's own photos - local only, never in the public repo.
design/mockups/local/

# Node dependencies (playwright for the mockup shooter).
node_modules/

# KUIPS sheet built by the NDim builder (AGPL-3.0 code embedded) and screen shots with the owner's photos - local only.
design/flow-map.html
design/flow-map/screens/

# Python bytecode (tools/*.py imported by check scripts)
__pycache__/
