<?xml version="1.0" encoding="utf-8"?>
<!-- KARTUN window theme. The Android 12+ launch splash draws only the icon's FOREGROUND layer (the heart with the
     faded glass around it) on the splash background, so both the splash background and the icon's backing disc take
     the icon's own glass colour (ic_launcher_background, generated by tools/make-icon.py): the heart then sits on one
     seamless dark field. The window background matches, so there is no flash between the splash and the first frame.
     [TESTED: 2026-10-14 · splash captured on the Titan right after `am start` - see design/icon/splash_titan.png] -->
<resources>
    <style name="Theme.KARTUN" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
