<?xml version="1.0" encoding="utf-8"?>
<!-- KARTUN manifest. No storage permissions: photos come through the system photo picker or another app's «Поделиться»
     (plans/01 §2.3); INTERNET serves «Вставить ссылку» only (interview #001, Q1 = A). largeHeap: a 4x
     result of a 12 MP photo is held as one bitmap until phase 1 streams tiles to disk (plans/03, risks). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The foreground service that keeps a running upscale alive when the app is left (plans/03 slice 2). These are
         normal (install-time) permissions: no dialog. -->
    <!-- The network serves only «Вставить ссылку» (and, later, model downloads) - [OWNER] interview #001, Q1 = A. The
         upscale itself never touches it (AGENT_GUIDE.md architecture rule). Install-time, no dialog. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- [OWNER] interview #004 Q1 = A: asked at the first «Улучшить»; the settings row «Уведомления» asks again or explains. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />

    <!-- Launcher icon: adaptive, generated from the owner's picture by tools/make-icon.py (design/icon/). -->
    <application
        android:name=".KartunApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.KARTUN">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- «Поделиться → KARTUN» from a gallery, Telegram, a browser or a file manager (the share hint on the home
                 screen). application/octet-stream: Android's media store has no type for .tga and the like (on the Titan
                 2026-10-16 a TGA came as application/octet-stream), so without it a TGA never reaches the engine's second
                 decoder; any other unknown file gets the honest «Не удалось открыть это фото». Snapseed on the same
                 tablet takes the same type. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- «Открыть с помощью → KARTUN» from a file manager (plans/08 step 10): a content URI of an image, the home
                 screen stays as approved ([OWNER] 2026-10-16 ≈ 16:10). The PSD types are those some file managers use;
                 application/octet-stream - as for «Поделиться» above.
                 [TESTED: 2026-10-16 · PSD (image/x-photoshop) and TIFF from the Files app on the Titan → «Улучшение» →
                 result 1024 × 1024, by the UI agent; TGA needed octet-stream - testcases/reports/2026-10-16_open_with_titan.md] -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/x-photoshop" />
                <data android:mimeType="application/photoshop" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
        <!-- «Поделиться»: the result's PNG copy in the cache, readable by the app the user picks (ResultStore.shareCopy). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/share_paths" />
        </provider>
        <service
            android:name=".UpscaleService"
            android:exported="false"
            android:foregroundServiceType="mediaProcessing" />
        <!-- The ADB door for AI agents (plans/06 §4.2, plans/07): exported, but only a caller holding DUMP may start it -
             the adb shell does, an app on the device does not (criterion A7). Both builds: [OWNER] interview #005, Q3 = A. -->
        <service
            android:name=".agent.AgentService"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:foregroundServiceType="mediaProcessing" />
    </application>
</manifest>
